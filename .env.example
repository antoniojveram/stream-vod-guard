# ---------------------------------------------------------------------------
# Stream VOD Guard · configuration
# Copy this file to .env and edit the channel and paths.
# ---------------------------------------------------------------------------

APP_NAME=Stream VOD Guard
APP_MARK=SV

TZ=Europe/Madrid
PORT=8787

# ---------------------------------------------------------------------------
# Paths (Docker Compose). Inside the container the mounts are /data and /videos.
# ---------------------------------------------------------------------------
# Parent folder on the host mounted at /videos. The dashboard can browse and
# select any subfolder (and create new ones).
VIDEOS_HOST_PATH=./videos
VIDEOS_ROOT=/videos
VIDEOS_HOST_ROOT=./videos

# Initial destination inside the container. You can change it in the dashboard.
RECORDINGS_DIR=/videos/recordings
# Path shown in the dashboard (normally the same as VIDEOS_HOST_ROOT + folder).
ARCHIVE_DISPLAY_PATH=./videos/recordings
# Internal state, logs and temporary capture chunks.
DATA_HOST_PATH=./data

# Container/dashboard settings (change per instance if you run several channels).
CONTAINER_NAME=stream-vod-guard
DASHBOARD_PORT=8787
DASHBOARD_BIND=127.0.0.1
APP_ENV_FILE=.env

# Final file name template. Placeholders:
# {channel} {date} {title} {platform} {id} {game}
FILENAME_TEMPLATE={channel} - {date} - {title} [{platform}-{id}]

# ---------------------------------------------------------------------------
# Twitch · accepts login, @login or a full URL
# ---------------------------------------------------------------------------
TWITCH_ENABLED=true
TWITCH_CHANNEL=
# TWITCH_CHANNEL=https://www.twitch.tv/your_channel
TWITCH_POLL_MS=5000
TWITCH_QUALITY=best
TWITCH_DISABLE_ADS=true
# Optional: account token for subscriber-only content or fewer ads.
# TWITCH_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# YouTube · accepts a channel ID (UC...), @handle or a full URL
# ---------------------------------------------------------------------------
YOUTUBE_ENABLED=true
YOUTUBE_CHANNEL=
# Alternative: YOUTUBE_CHANNEL_ID=UC...
YOUTUBE_CHANNEL_LABEL=
YOUTUBE_POLL_MS=30000
YOUTUBE_MAX_HEIGHT=0
# 0 = best available (including 4K/60 when offered). Set 1080 or 720 to cap.
YOUTUBE_LIVE_FROM_START=true
# Optional: cookies for members-only streams or login-gated content.
# YT_COOKIES_FILE=/data/cookies.txt

# ---------------------------------------------------------------------------
# Capture / watchdog
# ---------------------------------------------------------------------------
# No new bytes for this long triggers a restart. Keep it above a Twitch ad break.
STALL_TIMEOUT_MS=240000
RESTART_BACKOFF_MS=5000
OFFLINE_GRACE_MS=90000
WATCHDOG_MS=10000
CHECKSUM=true
KEEP_RAW=false
# Copy the final MKV to the selected destination. If it fails, it stays local.
ARCHIVE_ENABLED=true
# Old alias: ARCHIVE_TO_NAS=true

# ---------------------------------------------------------------------------
# Disk (GB)
# ---------------------------------------------------------------------------
MIN_FREE_GB=25
WARN_FREE_GB=60
MIN_FREE_ARCHIVE_GB=30
WARN_FREE_ARCHIVE_GB=100

# 0 = keep forever. 30 = delete finalized recordings older than 30 days.
RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Twitch VOD mute audit
# ---------------------------------------------------------------------------
VOD_AUDIT_ENABLED=true
VOD_POLL_MS=60000
VOD_WATCH_MAX_MS=86400000
SILENCE_NOISE_DB=-55
SILENCE_MIN_SECONDS=20
MUTE_SAMPLE_SECONDS=30
MUTE_PASS_DB=-55

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=stream-vod
# NTFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK=
NOTIFY_ON_LIVE=true

# Protect the dashboard if you expose it beyond localhost.
# DASHBOARD_TOKEN=change-me
